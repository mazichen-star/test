# 复制为 .streamlit/secrets.toml 后填写。不要把真实密钥提交到 Git。
# 线上（Streamlit Cloud）请配置 Supabase；没有配置时本地 SQLite 仅用于调试，
# PAA-DA 黏附数据不会持久化。

# ===== Supabase（线上必填） =====
SUPABASE_URL = "https://your-project.supabase.co"
SUPABASE_KEY = "your-anon-key"

# ===== 本地数据库路径（可选） =====
# LOCAL_DB_PATH = "data/app.db"

# ===== SMTP 找回密码（可选） =====
# 未配置时“忘记密码”会禁用，避免把临时密码暴露在页面上。
SMTP_HOST = "smtp.example.com"
SMTP_PORT = 465
SMTP_USER = "noreply@example.com"
SMTP_PASSWORD = "your-smtp-password"
SMTP_USE_SSL = true

# ===== AI（表格清洗 / PAA-DA 文献抽取与解释，可选） =====
# 清洗只发送表格前 50 行；文献抽取发送 PDF 文本块；不配置则使用手动 JSON/规则清洗。
DEEPSEEK_API_KEY = ""
DEEPSEEK_MODEL = "deepseek-chat"

# 火山方舟（可选，二选一）
# ARK_API_KEY = ""
# ARK_MODEL = "ep-xxxxxxxx"
