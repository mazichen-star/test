# 复制为 .streamlit/secrets.toml 后填写。不要把真实密钥提交到 Git。
# 没有 Supabase 配置时，应用会自动使用本地 SQLite（data/app.db）。

# ===== Supabase（可选） =====
SUPABASE_URL = "https://your-project.supabase.co"
SUPABASE_KEY = "your-anon-key"

# ===== 本地数据库路径（可选） =====
# LOCAL_DB_PATH = "data/app.db"

# ===== SMTP 找回密码（可选） =====
# 未配置时“忘记密码”会禁用，避免把临时密码暴露在页面上。
SMTP_HOST = "smtp.example.com"
SMTP_PORT = 465
SMTP_USER = "noreply@example.com"
SMTP_PASSWORD = "your-smtp-password"
SMTP_USE_SSL = true

# ===== AI 表格清洗（可选） =====
# 只发送表格前 50 行；不配置则使用规则清洗/原始表格。
DEEPSEEK_API_KEY = ""
DEEPSEEK_MODEL = "deepseek-chat"

# 火山方舟（可选，二选一）
# ARK_API_KEY = ""
# ARK_MODEL = "ep-xxxxxxxx"
